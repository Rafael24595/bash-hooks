#!/bin/bash

_VERSION="0.20.0"
_PROJECT_VERSION="0.25.0"

_REPOSITORY="https://github.com/Rafael24595/bash-hooks"
_REMOTE_DATA="https://raw.githubusercontent.com/Rafael24595/bash-hooks/refs/heads/main/project.toml"

_CURRENT_LOCATION="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ========= #
# CONSTANTS #
# ========= #

# Color codes
BOLD="\033[1m"
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RESET="\033[0m"

INSTALLER_NAME="$(basename "$0")"
REMOTE_LOCATION=".remote-scripts"

DEFAULT_HOOK_MODE="pre-commit"
DEFAULT_INPUT_PATTERN="pre-commit-build.y*ml"
DEFAULT_OUTPUT_FILE=".git/hooks/${DEFAULT_HOOK_MODE}"
DEFAULT_DISABLED_HOOK=false

# ========= #
# UTILITIES #
# ========= #

exit_error() {
    local MESSAGE=$1

    echo -e "\n${RED}Error: ${MESSAGE}${RESET}\n" >&2

    if [[ -n "$BUILD_FILE" ]]; then
        rm -f "$BUILD_FILE"
    fi

    exit 1
}

truncate_file() {
    local FILE=$1
    'true' > "$FILE"
}

require_file() {
    local FILE=$1
    if [[ ! -f "$FILE" ]]; then
        exit_error "File does not exist."
    fi
}

print_separator() {
    echo -e "\n------------------------------------------------------------------------------------------------"
}

# === #
# CLI #
# === #

# -------------- #
# Parsed options #
# -------------- #

WORKSPACE="."
INPUT_PATTERN=$DEFAULT_INPUT_PATTERN
OUTPUT_FILE=$DEFAULT_OUTPUT_FILE
HOOK_MODE=$DEFAULT_HOOK_MODE

IS_TEST=false
IS_BLOCK=false

EXECUTE_UPDATE=false
UPDATE_VERSION=""

EXECUTE_PULL=false
PULL_TARGET=""

EXECUTE_SYNC=false
SYNC_TAG=""

EXECUTE_STATUS=false
DISABLED_HOOK=$DEFAULT_DISABLED_HOOK
SCRIPT_STATES=()

# --------- #
# Functions #
# --------- #

print_help() {
    echo -e "\nUsage:"
    echo -e "  $INSTALLER_NAME [flags]"

    echo -e "\nFlags:"

    echo -e "  System flags:"
    echo -e "   -h --help                    $YELLOW Help command. $RESET"
    echo -e "   -v --version                 $YELLOW Shows the installer version and the project release it belongs to. $RESET"
    echo -e "   -u --update[=<project-tag>]  $YELLOW Updates the installer from the given project release (see --version). Without a tag, it is updated from the main branch. $RESET"

    echo -e "\n  Build flags:"
    echo -e "      --mode=<type>             $YELLOW Specifies the build mode. Default is pre_commit. Valid options: pre_commit, pre_push. $RESET"
    echo -e "      --workspace=<path>        $YELLOW Defines the workspace where the script will be placed. $RESET"
    echo -e "      --input=<path>            $YELLOW Defines the directory and name where the input file is located. $RESET"
    echo -e "      --output=<path>           $YELLOW Defines directory and name where the script will be placed. $RESET"
    echo -e "   -b --block                   $YELLOW Generates the script as a single file without imports. $RESET"
    echo -e "   -t --test                    $YELLOW The script will be mounted inside the remote-scripts directory to prevent it from being used by Git. $RESET"

    echo -e "\n  Hook state flags:"
    echo -e "   -d --disable[=<id>]          $YELLOW Disables the given scripts, or the whole hook if none is given. $RESET"
    echo -e "   -e --enable[=<id>]           $YELLOW Enables the given scripts, or the whole hook if none is given. $RESET"

    echo -e "\n  Remote flags:"
    echo -e "     --pull=<target/file:tag>   $YELLOW Downloads the specified remote script at the given version. Example: golang/sh/run-govulncheck.sh:0.6.3 $RESET"
    echo -e "     --sync[=<tag>]             $YELLOW Sets the tag of every bash-hooks remote script in the input file to the given version. If a version is not specified, the latest version is used. $RESET"
    echo ""
}

validate_global_state_input() {
    local CANDIDATE="$1"

    if [[ "$EXECUTE_STATUS" == false ]]; then
        return 0
    fi

    if (( ${#SCRIPT_STATES[@]} > 0 )); then
        echo -e "${RED}\nError: incompatible options: global hook status cannot be set while individual hook statuses are specified.${RESET}"
        return 2
    fi

    if [[ "$DISABLED_HOOK" == "$CANDIDATE" ]]; then
        return 0
    fi

    echo -e "${RED}\nError: incompatible options: --enable and --disable cannot be used together.${RESET}"
    return 2
}

validate_script_state_input() {
    if [[ "$EXECUTE_STATUS" == false ]] || (( ${#SCRIPT_STATES[@]} > 0 )); then
        return 0
    fi

    echo -e "${RED}\nError: incompatible options: global hook status cannot be set while individual hook statuses are specified.${RESET}"

    return 2
}

parse_arguments() {
    local ARG
    local BLOCK

    local BLOCKS=()

    for ARG in "$@"; do
    case "$ARG" in
        --help | -h)
            print_help
            exit 0
            ;;
        --version | -v)
            echo "$INSTALLER_NAME $_VERSION (project $_PROJECT_VERSION)"
            echo "$_REPOSITORY"
            exit 0
            ;;
        --update=* | -u=*)
            EXECUTE_UPDATE=true
            UPDATE_VERSION="${ARG#*=}"
            ;;
        --update | -u)
            EXECUTE_UPDATE=true
            ;;
        
        --mode=*)
            ARG="${ARG#--mode=}"
            case "$ARG" in
                "pre_commit")
                HOOK_MODE="pre-commit"
                ;;
                "pre_push")
                HOOK_MODE="pre-push"
                ;;
                *)
                echo -e "${RED}\nError: unknown option: $ARG${RESET}"
                exit 2
                ;;
            esac
            OUTPUT_FILE=".git/hooks/${HOOK_MODE}"
            ;;
        --workspace=*)
            WORKSPACE="${ARG#*=}"
            ;;
        --input=*)
            INPUT_PATTERN="${ARG#*=}"
            ;;
        --output=*)
            OUTPUT_FILE="${ARG#*=}"
            ;;
        --block | -b)
            IS_BLOCK=true
            ;;
        --test | -t)
            IS_TEST=true
            OUTPUT_FILE="${REMOTE_LOCATION}/.temp/.${HOOK_MODE}"
            ;;
        
        --enable | -e)
            validate_global_state_input false || exit $?

            EXECUTE_STATUS=true
            DISABLED_HOOK=false
            ;;
        --enable=* | -e=*)
            validate_script_state_input || exit $?

            EXECUTE_STATUS=true
            
            IFS=',' read -ra BLOCKS <<< "${ARG#*=}"
            for BLOCK in "${BLOCKS[@]}"; do
                SCRIPT_STATES+=("${BLOCK}=true")
            done
            ;;
        --disable | -d)
            validate_global_state_input true || exit $?

            EXECUTE_STATUS=true
            DISABLED_HOOK=true
            ;;
        --disable=* | -d=*)
            validate_script_state_input || exit $?

            EXECUTE_STATUS=true

            IFS=',' read -ra BLOCKS <<< "${ARG#*=}"
            for BLOCK in "${BLOCKS[@]}"; do
                SCRIPT_STATES+=("${BLOCK}=false")
            done
            ;;
        
        --pull=*)
            EXECUTE_PULL=true
            PULL_TARGET="${ARG#--pull=}"
            REMOTE_LOCATION="."
            ;;
        --sync)
            EXECUTE_SYNC=true
            ;;
        --sync=*)
            EXECUTE_SYNC=true
            SYNC_TAG="${ARG#*=}"
            ;;
        *)
            echo -e "${RED}\nError: unknown option: $ARG${RESET}"
            exit 2
            ;;
    esac
    done
}

# ========== #
# HOOK STATE #
# ========== #

hook_variable_name() {
    local SCRIPT_ID="$1"

    SCRIPT_ID="${SCRIPT_ID^^}"
    SCRIPT_ID="${SCRIPT_ID//-/_}"

    echo "HOOK_${SCRIPT_ID}"
}

set_hook_variable() {
    local HOOK_NAME=$1
    local NEW_STATE=$2

    local TEMP_FILE="${OUTPUT_FILE}.tmp"

    if [[ ! -f "$OUTPUT_FILE" ]]; then
        echo -e "${RED}Hook '$OUTPUT_FILE' does not exist.${RESET}"
        return 1
    fi

    if ! grep -q "^${HOOK_NAME}=" "$OUTPUT_FILE"; then
        echo -e "${RED}Unknown hook '${HOOK_NAME}' in '$OUTPUT_FILE'.${RESET}" >&2
        return 1
    fi

    if ! cp -p "$OUTPUT_FILE" "$TEMP_FILE"; then
        echo -e "${RED}Failed to update hook '$OUTPUT_FILE'.${RESET}"
        return 1
    fi

    if ! sed "s/^${HOOK_NAME}=.*/${HOOK_NAME}=${NEW_STATE}/" "$OUTPUT_FILE" > "$TEMP_FILE"; then
        echo -e "${RED}Failed to update hook '$OUTPUT_FILE'.${RESET}"
        rm -f "$TEMP_FILE"
        return 1
    fi

    if ! mv "$TEMP_FILE" "$OUTPUT_FILE"; then
        echo -e "${RED}Failed to replace hook '$OUTPUT_FILE'.${RESET}"
        rm -f "$TEMP_FILE"
        return 1
    fi
}

set_global_hook_state() {
    if ! set_hook_variable "DISABLED_HOOK" "$DISABLED_HOOK"; then
        echo -e "${RED}Failed to update global hook state.${RESET}"
        return 1
    fi

    if [[ "${DISABLED_HOOK}" == true ]]; then
        echo -e "${YELLOW}The hook '${OUTPUT_FILE}' has been disabled.${RESET}"
    else
        echo -e "${YELLOW}The hook '${OUTPUT_FILE}' has been enabled.${RESET}"
    fi
}

set_script_states() {
     for HOOK_TUPLE in "${SCRIPT_STATES[@]}"; do
        local HOOK_NAME
        local HOOK_STATUS

        HOOK_NAME=$(hook_variable_name "${HOOK_TUPLE%%=*}")
        HOOK_STATUS="${HOOK_TUPLE#*=}"

        if ! set_hook_variable "$HOOK_NAME" "$HOOK_STATUS"; then
            echo -e "${RED}Failed to update hook '${HOOK_NAME}'.${RESET}"
            return 1
        fi

        if [[ "${HOOK_STATUS}" == true ]]; then
            echo -e "${YELLOW}The hook '${HOOK_NAME}' has been enabled.${RESET}"
        else
            echo -e "${YELLOW}The hook '${HOOK_NAME}' has been disabled.${RESET}"
        fi
    done
}

# ===== #
# BUILD #
# ===== #

INPUT_FILE=""
BUILD_FILE=""

BLOCK_CONTENT="#!/bin/bash"

LAST_CONTENT=""
declare -A LOADED_SOURCES

# ----- #
# Files #
# ----- #

resolve_input_file() {
    local PATTERN="${WORKSPACE}/${INPUT_PATTERN}"
    local MATCHES

    mapfile -t MATCHES < <(compgen -G "$PATTERN")

    if (( ${#MATCHES[@]} == 0 )); then
        exit_error "No input file found matching '$PATTERN'."
    fi
    
    if (( ${#MATCHES[@]} > 1 )); then
        exit_error "Multiple input files found matching '$PATTERN'."
    fi

    INPUT_FILE="${MATCHES[0]}"
}

prepare_build_file() {
    mkdir -p "$(dirname "$OUTPUT_FILE")" \
        || exit_error "Cannot create directory for '$OUTPUT_FILE'."
    
    BUILD_FILE="${OUTPUT_FILE}.tmp"

    truncate_file "$BUILD_FILE"
    chmod +x "$BUILD_FILE"
}

publish_build_file() {
    if ! mv "$BUILD_FILE" "$OUTPUT_FILE"; then
        exit_error "Failed to install hook '$OUTPUT_FILE'."
    fi

    BUILD_FILE=""
}

# ------ #
# Remote #
# ------ #

resolve_remote_sources() {
    local NAME=$1
    local PROJECT=$2
    local TAG=$3
    local SCRIPT=$4

    local FILE="${NAME##*/}"
    
    local SOURCES
    SOURCES=$(grep -oP '^\s*source\s+\K([^\s#]+)' <<< "$SCRIPT")
    if [[ -z "$SOURCES" ]]; then
        LAST_CONTENT="${SCRIPT}"
        return
    fi

    echo -e "\nLoading resources from ${BOLD}${FILE}${RESET}..."

    local UPDATED_SCRIPT="${SCRIPT}"

    for SOURCE in $SOURCES; do
        local LOCAL_SOURCE="$SOURCE"
        local FIX_SOURCE="${LOCAL_SOURCE#./}"

        local FILE_URL="https://raw.githubusercontent.com/${PROJECT}/refs/tags/${TAG}/${LOCAL_SOURCE}"

        local FILE_SOURCE="${SOURCE##*/}"

        if [[ ! -v LOADED_SOURCES["$FIX_SOURCE"] ]]; then
            echo -e "Source found: ${FIX_SOURCE}"
            fetch_remote_script "$PROJECT" "$FILE_URL" "$FIX_SOURCE" false
            LOADED_SOURCES["$FIX_SOURCE"]=1

            COUNT_SOURCES=$((COUNT_SOURCES + 1))
            if [[ -n "$LIST_SOURCES" ]]; then
                LIST_SOURCES+=", "
            fi
            LIST_SOURCES+="${GREEN}$FILE_SOURCE${RESET}"
        else
            echo -e "Source found: ${FIX_SOURCE} [${GREEN}cached${RESET}]"
        fi

        local UPDATED_SOURCE="${REMOTE_LOCATION}/${FIX_SOURCE}"

        UPDATED_SCRIPT=${UPDATED_SCRIPT//"$LOCAL_SOURCE"/"$UPDATED_SOURCE"}
    done
    
    LAST_CONTENT="${UPDATED_SCRIPT}"
}

fetch_remote_script() {
    local PROJECT=$1
    local FILE_URL=$2
    local NAME=$3
    local IS_MAIN=$4

    local FILE="${NAME##*/}"

    echo -e "\nFetching ${FILE} from ${BOLD}'${FILE_URL}'${RESET}..."

    if ! CONTENT=$(curl -sf "$FILE_URL") ; then
        exit_error "Failed to retrieve script from GitHub."
    fi

    resolve_remote_sources "$NAME" "$PROJECT" "$TAG" "${CONTENT}"
    CONTENT="${LAST_CONTENT}"

    if [[ $IS_BLOCK == true ]]; then
        block_add_package "$NAME" "$CONTENT" "$IS_MAIN"
    else
        SCRIPT="${WORKSPACE}/${REMOTE_LOCATION}/${NAME}"

        mkdir -p "$(dirname "$SCRIPT")"
        touch "$SCRIPT"

        truncate_file "$SCRIPT"

        echo "$CONTENT" >> "${SCRIPT}"
        chmod +x "$SCRIPT"
    fi
}

# ---------- #
# Block mode #
# ---------- #

package_function_name() {
    local PACKAGE="$1"
    
    PACKAGE="${PACKAGE%.*}"

    PACKAGE="${PACKAGE#./}"
    PACKAGE="${PACKAGE#../}"

    PACKAGE="${PACKAGE//[-\/\\]/_}"

    echo "package_$PACKAGE"
}

block_add_package() {
    local PACKAGE=$1
    local FILE_CONTENT=$2
    local IS_MAIN=$3
    
    FILE_CONTENT=${FILE_CONTENT//"#!/bin/bash"$'\n\n'/""}
    # shellcheck disable=SC2001
    FILE_CONTENT=$(echo "$FILE_CONTENT" | sed 's/^source /### source /')

    if [[ "$IS_MAIN" == true ]]; then
        local FUNCTION
        FUNCTION=$(package_function_name "$PACKAGE")

        # shellcheck disable=SC2001
        INDENTED_CONTENT=$(echo "$FILE_CONTENT" | sed 's/^/    /')

        BLOCK_CONTENT="$BLOCK_CONTENT"$'\n\n'"### ### ### Function Package: $PACKAGE ### ### ###"$'\n'
        BLOCK_CONTENT="$BLOCK_CONTENT"$'\n'"$FUNCTION() {"$'\n'"$INDENTED_CONTENT"$'\n'"}"
    else
        BLOCK_CONTENT="$BLOCK_CONTENT"$'\n\n'"### ### ### Source Package: $PACKAGE ### ### ###"$'\n'
        BLOCK_CONTENT="$BLOCK_CONTENT"$'\n'"$FILE_CONTENT"
    fi
}

block_add_local_sources() {
    local NAME=$1
    local SCRIPT=$2
    
    local SOURCES
    SOURCES=$(grep -oP '^\s*source\s+\K([^\s#]+)' <<< "$SCRIPT")
    if [[ -z "$SOURCES" ]]; then
        return
    fi

    echo -e "\nReading resources from ${BOLD}${NAME}${RESET}..."

    for SOURCE in $SOURCES; do
        local LOCAL_SOURCE="$SOURCE"
        local FIX_SOURCE="${LOCAL_SOURCE#./}"

        if [[ ! -v LOADED_SOURCES["$FIX_SOURCE"] ]]; then
            echo -e "Source found: ${FIX_SOURCE}"

            block_add_local_package "$FIX_SOURCE"

            LOADED_SOURCES["$FIX_SOURCE"]=1
        else
            echo -e "Source found: ${FIX_SOURCE} [${GREEN}cached${RESET}]"
        fi
    done
}

block_add_local_package() {
    local PACKAGE=$1
    local IS_MAIN=$2
    
    local LOCATION="${WORKSPACE}/${PACKAGE}"

    require_file "$LOCATION"

    local FILE_CONTENT
    FILE_CONTENT=$(<"$LOCATION")

    block_add_local_sources "$PACKAGE" "$FILE_CONTENT"

    block_add_package "$PACKAGE" "$FILE_CONTENT" "$IS_MAIN"
}

# ----------- #
# Hook writer #
# ----------- #

write_script_invocation() {
    local SCRIPT_ID=$1
    local SCRIPT=$2
    local EXPECT=$3
    local RETURN=$4
    local ARGS=$5
    local FLAGS=$6
    local IS_REMOTE=$7

    local HOOK_NAME
    local LOG_DIRECTION="ne"
    local LOG_RETURN=1

    if [[ "$IS_BLOCK" == true ]]; then
        SCRIPT=$(package_function_name "$SCRIPT")
    elif [[ "$IS_REMOTE" == true ]]; then
        SCRIPT="$REMOTE_LOCATION/$SCRIPT"
    fi

    if [[ "$EXPECT" == "true" ]]; then
        LOG_DIRECTION="eq"
    fi

    if [[ "$RETURN" == "true" ]]; then
        LOG_RETURN=0
    fi

    local LOG_FLAGS=""
    for flag in $FLAGS; do
        if [[ -n "$LOG_FLAGS" ]]; then
            LOG_FLAGS+=" "
        fi
        LOG_FLAGS+="--$flag"
    done

    ARGS="${ARGS#"${ARGS%%[![:space:]]*}"}"
    ARGS="${ARGS%"${ARGS##*[![:space:]]}"}"

    if [[ -n "$ARGS" ]]; then
        ARGS=" $ARGS"
    fi

    if [[ -n "$LOG_FLAGS" ]]; then
        LOG_FLAGS=" $LOG_FLAGS"
    fi

    HOOK_NAME=$(hook_variable_name "$SCRIPT_ID")

    {
        echo
        echo -e "${HOOK_NAME}=true"
        echo -e "if [[ \"\${$HOOK_NAME}\" == true ]]; then"
        echo -e "  printf \"\${BOLD}\\\\nExecuting '${SCRIPT}' script...\${RESET}\\\\n\""
        echo -e "  $SCRIPT$ARGS$LOG_FLAGS"
        echo -e "  EXIT_CODE=\$?"
        echo -e "  if [[ \$EXIT_CODE -eq 2 ]]; then"
        echo -e "      exit 1"
        echo -e "  fi"
        echo -e "  if [[ \$EXIT_CODE -${LOG_DIRECTION} 0 ]]; then"
        echo -e "      exit ${LOG_RETURN}"
        echo -e "  fi"
        echo -e "  printf \"\${BOLD}\\\\n <-----------------> \\\\n\${RESET}\""
        echo -e "fi"
    } >> "$BUILD_FILE"
}

# ------- #
# Loaders #
# ------- #

load_sources() {
    echo -e "${YELLOW}\nLoading sources...${RESET}"

    SOURCES=$(yq eval '.hooks.local.sources[].path' "${INPUT_FILE}")
    if [[ -z "$SOURCES" ]]; then
        echo -e "${GREEN}\nNo remote scripts found.${RESET}"
        return
    fi

    for SOURCE in $SOURCES; do
        {
            echo -e "\n# Import ${SOURCE}"
            echo "source ${SOURCE}"
        } >> "$BUILD_FILE"

        chmod +x "$SOURCE"

        COUNT_SOURCES=$((COUNT_SOURCES + 1))
        if [[ -n "$LIST_SOURCES" ]]; then
            LIST_SOURCES+=", "
        fi
        LIST_SOURCES+="${GREEN}$SOURCE${RESET}"
    done

    echo ""
}

load_remote_scripts() {
    echo -e "\n${YELLOW}Loading remote scipts...${RESET}"

    REPO_IDS=$(yq eval '.hooks.remote.repos[].id' "${INPUT_FILE}")
    if [[ -z "$REPO_IDS" ]]; then
        echo -e "${GREEN}\nNo remote scripts found.${RESET}"
        return
    fi

    for REPO_ID in $REPO_IDS; do
        NAME=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .name" "${INPUT_FILE}")
        ORIGIN=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .origin" "${INPUT_FILE}")
        TAG=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .tag" "${INPUT_FILE}")
        TARGET=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .target" "${INPUT_FILE}")
        
        EXPECT=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .expect" "${INPUT_FILE}")
        RETURN=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .return" "${INPUT_FILE}")

        ARGS=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .args[]" "${INPUT_FILE}" | tr '\n' ' ')
        FLAGS=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .flags[]" "${INPUT_FILE}" | tr '\n' ' ')
        FILE_URL=""

        if [[ $NAME != *.sh ]]; then
            exit_error "Only Bash scripts are supported so far."
        fi

        local PROJECT=""
        if [[ "$ORIGIN" == https://github.com* ]]; then
            PROJECT="${ORIGIN#https://github.com/}"
            FILE_URL="https://raw.githubusercontent.com/${PROJECT}/refs/tags/${TAG}/${TARGET}/${NAME}"
        else
            exit_error "Currently, only GitHub repositories are supported."
        fi

        echo -e "\nReading ${BOLD}'${NAME}' script configuration${RESET}..."

        DISABLED=$(yq e ".hooks.remote.repos[] | select(.id == \"${REPO_ID}\") | .disabled" "${INPUT_FILE}")
        if [[ "$DISABLED" == "true" ]]; then
            echo -e "${YELLOW}The script is flagged as disabled; skipping....${RESET}"
            COUNT_IGNORED=$((COUNT_IGNORED + 1))
            if [[ -n "$LIST_IGNORED" ]]; then
                LIST_IGNORED+=", "
            fi
            LIST_IGNORED+="${GREEN}$NAME${RESET}"

            continue
        fi

        local LOCATION="${TARGET}/${NAME}"

        fetch_remote_script "$PROJECT" "$FILE_URL" "$LOCATION" true
        
        write_script_invocation "$REPO_ID" "$LOCATION" "$EXPECT" "$RETURN" "$ARGS" "$FLAGS" true

        COUNT_REMOTE=$((COUNT_REMOTE + 1))
        if [[ -n "$LIST_REMOTE" ]]; then
            LIST_REMOTE+=", "
        fi
        LIST_REMOTE+="${GREEN}$NAME${RESET}"

        echo -e "${GREEN}Script loadded successfully.${RESET}"
    done
}

load_local_scripts() {
    echo -e "${YELLOW}\nLoading local scipts...${RESET}"

    SCRIPT_IDS=$(yq eval '.hooks.local.scripts[].id' "${INPUT_FILE}")
    if [[ -z "$SCRIPT_IDS" ]]; then
        echo -e "${GREEN}\nNo local scripts found.${RESET}"
        return
    fi

    for SCRIPT_ID in $SCRIPT_IDS; do
        SCRIPT=$(yq e ".hooks.local.scripts[] | select(.id == \"${SCRIPT_ID}\") | .path" "${INPUT_FILE}")

        EXPECT=$(yq e ".hooks.local.scripts[] | select(.id == \"${SCRIPT_ID}\") | .expect" "${INPUT_FILE}")
        RETURN=$(yq e ".hooks.local.scripts[] | select(.id == \"${SCRIPT_ID}\") | .return" "${INPUT_FILE}")

        ARGS=$(yq e ".hooks.local.scripts[] | select(.id == \"${SCRIPT_ID}\") | .args[]" "${INPUT_FILE}" | tr '\n' ' ')
        FLAGS=$(yq e ".hooks.local.scripts[] | select(.id == \"${SCRIPT_ID}\") | .flags[]" "${INPUT_FILE}" | tr '\n' ' ')

        echo -e "\nReading ${BOLD}'${SCRIPT}' script${RESET}..."

        DISABLED=$(yq e ".hooks.local.scripts[] | select(.id == \"${SCRIPT_ID}\") | .disabled" "${INPUT_FILE}")
        if [[ "$DISABLED" == "true" ]]; then
            echo -e "${YELLOW}The script is flagged as disabled; skipping...${RESET}"
            COUNT_IGNORED=$((COUNT_IGNORED + 1))
            if [[ -n "$LIST_IGNORED" ]]; then
                LIST_IGNORED+=", "
            fi
            LIST_IGNORED+="${GREEN}$SCRIPT_ID${RESET}"

            continue
        fi

        if [[ $IS_BLOCK == true ]]; then
            block_add_local_package "$SCRIPT" true
        fi

        local LOCATION="${WORKSPACE}/${SCRIPT}"

        require_file "$LOCATION"

        write_script_invocation "$SCRIPT_ID" "$SCRIPT" "$EXPECT" "$RETURN" "$ARGS" "$FLAGS" false

        chmod +x "$LOCATION"

        echo -e "${GREEN}Script loadded successfully.${RESET}"

        COUNT_LOCAL=$((COUNT_LOCAL + 1))
        if [[ -n "$LIST_LOCAL" ]]; then
            LIST_LOCAL+=", "
        fi
        LIST_LOCAL+="${GREEN}$SCRIPT_ID${RESET}"
    done
}

# ------ #
# Report #
# ------ #

START_TIME=$(date +%s%3N)

COUNT_SOURCES=0
COUNT_LOCAL=0
COUNT_REMOTE=0
COUNT_IGNORED=0

LIST_SOURCES=""
LIST_LOCAL=""
LIST_REMOTE=""
LIST_IGNORED=""

print_build_summary() {
    END_TIME=$(date +%s%3N)
    TIME=$((END_TIME - START_TIME))

    echo -e "[${BOLD}$COUNT_REMOTE${RESET}] Remote scripts: $LIST_REMOTE"
    echo -e "[${BOLD}$COUNT_SOURCES${RESET}] Sources: $LIST_SOURCES"
    echo -e "[${BOLD}$COUNT_LOCAL${RESET}] Local scripts: $LIST_LOCAL"
    echo -e "[${BOLD}$COUNT_IGNORED${RESET}] Ignored scripts: $LIST_IGNORED"

    echo -e "\n${YELLOW}Execution time: ${TIME} ms${RESET}"

    echo ""
}

# ======= #
# ACTIONS #
# ======= #

action_update() {
    local VERSION=$1

    REFERENCE="heads/main"
    if [[ -z "$VERSION" ]]; then
        VERSION="latest"
    else
        echo -e "\n${YELLOW}Be careful, some changes may not be compatible with older versions:${RESET}"
        echo -e "\n - ${YELLOW}The update flag was implemented in version 0.0.5. The command cannot be recognized in earlier versions.${RESET}"
        echo -e "\n - ${YELLOW}The installer name was changed in version 0.16.0 from 'install-pre-commit' to '$INSTALLER_NAME'.${RESET}"
        echo -e "\n - ${YELLOW}The update process may modify the current bash-hooks installation.${RESET}"

        read -r -p "$(echo -e "\n\n${YELLOW}Do you want to continue? (y/n): ${RESET}")" RESPONSE
        RESPONSE=$(echo "$RESPONSE" | tr '[:upper:]' '[:lower:]')

        if [[ "$RESPONSE" == "yes" ]] || [[ "$RESPONSE" == "y" ]]; then
            :
        elif [[ "$RESPONSE" == "no" ]] || [[ "$RESPONSE" == "n" ]]; then
            echo -e "\n${RED}The updating process has been canceled.${RESET}\n"
            exit 0
        fi

        REFERENCE="tags/${VERSION}"
    fi

    FILE_URL="https://raw.githubusercontent.com/Rafael24595/bash-hooks/refs/${REFERENCE}/${INSTALLER_NAME}"

    echo -e "\nUpdating installer to ${BOLD}${VERSION}${RESET} version from ${BOLD}'${FILE_URL}'${RESET}..."

    if ! CONTENT=$(curl -sf "$FILE_URL") ; then
        exit_error "Failed to retrieve script from GitHub."
    fi

    echo -e "${GREEN}Installer updated successfully.${RESET}\n"

    SCRIPT="${_CURRENT_LOCATION}/${INSTALLER_NAME}"

    touch "$SCRIPT"

    truncate_file "$SCRIPT"

    echo "$CONTENT" >> "${SCRIPT}"
    chmod +x "$SCRIPT"
}

action_pull() {
    local SOURCE=$1

    local TAG="${SOURCE##*:}"
    local URL="${SOURCE%%:*}"
    local NAME="${URL##*/}"
    local TARGET="${URL%/*}"

    local PROJECT="Rafael24595/bash-hooks"

    local FILE_URL="https://raw.githubusercontent.com/${PROJECT}/refs/tags/${TAG}/${TARGET}/${NAME}"

    echo -e "\n${GREEN}Downloading script ${NAME}...${RESET}\n"

    fetch_remote_script "$PROJECT" "$FILE_URL" "$NAME" false
}

action_sync() {
    local PROJECT_VERSION="$1"

    echo -e "${BOLD}\nSyncing tags...${RESET}"

    if [[ -z "$PROJECT_VERSION" ]]; then
        echo -e "${BOLD}\nFetching project version from remote...\n${RESET}"
        echo -e "${YELLOW} - Remote source: $_REMOTE_DATA${RESET}"

        if ! CONTENT=$(curl -sf "$_REMOTE_DATA") ; then
            exit_error "Failed to retrieve script from GitHub."
        fi

        PROJECT_VERSION=$(grep -A 5 '^\[project\]' <<< "$CONTENT" | grep '^version' | head -n 1 | cut -d'"' -f2)
    fi

    echo -e "${YELLOW} - Detected version: $PROJECT_VERSION${RESET}"

    sed -i "/origin: https:\/\/github.com\/Rafael24595\/bash-hooks/{n; s/tag: .*/tag: $PROJECT_VERSION/}" "$INPUT_FILE"

    echo -e "${GREEN}\nTags updated to $PROJECT_VERSION in $INPUT_FILE.${RESET}\n"
}

action_status() {
    if (( ${#SCRIPT_STATES[@]} > 0 )); then
        set_script_states
    else
        set_global_hook_state
    fi
}

action_build() {
    if ! YAML_EVAL=$(yq eval '.' "$INPUT_FILE" 2>&1); then
        exit_error "Invalid YAML format: $YAML_EVAL"
    fi

    prepare_build_file

    if [[ "$IS_TEST" == true ]]; then
        echo -e "\n${YELLOW}${BOLD}Executing in test mode, script will be mounted in '${RESET}${GREEN}${BOLD}${OUTPUT_FILE}${RESET}${YELLOW}${BOLD}'.${RESET}"
    fi

    {
        echo "#!/bin/bash"
        echo -e "\n# Color codes"
        echo -e "BOLD=\"\\\033[1m\""
        echo -e "YELLOW=\"\\\033[0;33m\""
        echo -e "RESET=\"\\\033[0m\""
        echo -e "\nDISABLED_HOOK=$DEFAULT_DISABLED_HOOK"
        echo -e "if [[ \"\${DISABLED_HOOK}\" == true ]]; then"
        echo -e "   echo -e \"\${YELLOW}\${BOLD}Warning, the hook disabled.\"\${RESET}"
        echo -e "   exit 0"
        echo -e "fi"
    } >> "$BUILD_FILE"

    echo -e "\n${BOLD}Building ${HOOK_MODE} hook...${RESET}"

    print_separator

    echo -e "\n# <-- SOURCES -->" >> "$BUILD_FILE"

    load_sources
    print_separator

    echo -e "\n# <-- REPOSITORY SCRIPTS -->" >> "$BUILD_FILE"
    echo -e "\nprintf \"\${BOLD}\\\\nRepository scripts: \\\\n\${RESET}\"" >> "$BUILD_FILE"

    load_remote_scripts
    print_separator

    echo -e "\n# <-- LOCAL SCRIPTS -->" >> "$BUILD_FILE"
    echo -e "\nprintf \"\${BOLD}\\\\nLocal scripts: \\\\n\${RESET}\"" >> "$BUILD_FILE"

    load_local_scripts
    print_separator

    if [[ $IS_BLOCK == true ]]; then
        OUTPUT_CONTENT=$(<"$BUILD_FILE")
        OUTPUT_CONTENT=${OUTPUT_CONTENT//"#!/bin/sh"/$'\n'"### ### ### Source script ### ### ###"}
        BLOCK_CONTENT="$BLOCK_CONTENT"$'\n'"$OUTPUT_CONTENT"

        truncate_file "$BUILD_FILE"

        echo "$BLOCK_CONTENT" >> "$BUILD_FILE"
    fi

    publish_build_file

    echo -e "\n${BOLD}Hook has been building successfully.${RESET}\n"

    print_build_summary
}

# ==== #
# MAIN #
# ==== #

main() {
    parse_arguments "$@"

    OUTPUT_FILE="${WORKSPACE}/${OUTPUT_FILE}"

    if [[ "$EXECUTE_UPDATE" == true ]]; then
        action_update "$UPDATE_VERSION"
        exit 0
    fi

    if [[ "$EXECUTE_PULL" == true ]]; then
        action_pull "$PULL_TARGET"

        echo -e "\n${BOLD}The package has been downloaded successfully.${RESET}\n"

        print_build_summary
        exit 0
    fi

    if [[ "$EXECUTE_SYNC" == true ]]; then
        resolve_input_file
        action_sync "$SYNC_TAG"
        exit 0
    fi

    if [[ "$EXECUTE_STATUS" == true ]]; then
        action_status || exit 1
        exit 0
    fi

    resolve_input_file
    action_build
}

main "$@"
